{
  "manifest_version": 2,
  "name": "PV-IDM Integration Module",
  "version": "1.1.5",
  "description": "Internet Download Manager (PV-IDM) integration for Linux. Automatically intercepts downloads and provides video sniffer download panel.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background/service_worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/video_sniffer.js"],
      "css": ["content/sniffer.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "content/page_hook.js",
    "icons/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pv-idm@pv-idm.local",
      "strict_min_version": "90.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  }
}
